{
  "manifest_version": 3,
  "name": "Pairlin",
  "version": "0.1.0",
  "description": "True landed cost for EU shoppers — IOSS detection, customs calculation, automatic payments.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["iossDetector.js", "basketWatcher.js", "overlay.js", "content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle",
    "world": "MAIN"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pairlin"
  }
}
